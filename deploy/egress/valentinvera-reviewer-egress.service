[Unit]
Description=App-only egress filter for valentinvera-reviewer
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/valentinvera-reviewer-egress install --if-bridges-present --publish-bridge br-vvr-publish
# No ExecStop. Rollback is an explicit host-rules.sh rollback.

[Install]
WantedBy=multi-user.target
