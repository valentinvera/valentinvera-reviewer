# One-port loopback relay. Same Alpine manifest as the proxy. Not a general proxy.
# apk add of socat alone does not upgrade packages already in the base.
FROM alpine:3.22.8@sha256:9db2934886712d877c932e07249c75a59e6ca27adfbccc05261987a17bef2d63

RUN apk add --no-cache \
      'busybox=1.37.0-r20' \
      'busybox-binsh=1.37.0-r20' \
      'ssl_client=1.37.0-r20' \
      'musl=1.2.5-r13' \
      'musl-utils=1.2.5-r13' \
      'libcrypto3=3.5.9-r0' \
      'libssl3=3.5.9-r0' \
      'zlib=1.4-r0' \
      'ncurses-terminfo-base=6.5_p20250503-r0' \
      'libncursesw=6.5_p20250503-r0' \
      'readline=8.2.13-r1' \
      'socat=1.8.1.3-r0' \
    && apk list -I | grep -qx 'busybox-1.37.0-r20 .*' \
    && apk list -I | grep -qx 'libssl3-3.5.9-r0 .*' \
    && apk list -I | grep -qx 'libcrypto3-3.5.9-r0 .*' \
    && apk list -I | grep -qx 'musl-1.2.5-r13 .*' \
    && apk list -I | grep -qx 'zlib-1.4-r0 .*' \
    && apk list -I | grep -qx 'socat-1.8.1.3-r0 .*' \
    && socat -V | grep -q 'socat version 1.8.1.3'

COPY ingress-entrypoint.sh /usr/local/bin/ingress-entrypoint.sh
RUN chmod 0555 /usr/local/bin/ingress-entrypoint.sh

USER nobody

ENTRYPOINT ["/usr/local/bin/ingress-entrypoint.sh"]
