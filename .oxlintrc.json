{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["data/**", "secrets/**", "coverage/**", "dist/**"]
}
